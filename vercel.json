{
  "redirects": [
    {
      "source": "/me",
      "destination": "https://createmusic.fm/me",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/zombies",
      "destination": "/zombies.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
