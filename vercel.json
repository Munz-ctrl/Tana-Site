{
  "redirects": [
    {
      "source": "/me",
      "destination": "https://createmusic.fm/me",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/zombies",
      "destination": "/zombies.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index|zombies)(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
